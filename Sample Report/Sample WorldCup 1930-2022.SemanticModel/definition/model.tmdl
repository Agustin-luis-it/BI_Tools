model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-AR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DimNations","FactMatch","FactMatchTeam"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table DimNations
ref table FactMatch
ref table FactMatchTeam
ref table Measure
ref table DimNationsAux

ref cultureInfo en-US


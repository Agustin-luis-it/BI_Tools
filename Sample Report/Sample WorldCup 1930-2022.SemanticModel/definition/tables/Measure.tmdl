	measure 'Champions Awarded' =
			VAR _titles =
			    CALCULATETABLE(
			        VALUES(FactMatchTeam[year]),
			        FactMatchTeam[round] = "Final",
			        FactMatchTeam[result] = "W"
			    )
			VAR _count = COUNTROWS(_titles)
			VAR _years =
			    CONCATENATEX(
			        TOPN(99, _titles, FactMatchTeam[year], ASC),
			        FORMAT(FactMatchTeam[year], "0"),
			        ", ",
			        FactMatchTeam[year], ASC
			    )
			RETURN
			    IF(
			        _count = 0 || ISBLANK(_count),
			        "0",
			        FORMAT(_count, "0") & " (" & _years & ")"
			    )
		displayFolder: _information
		lineageTag: e08ac640-63d3-4359-be59-5f70cf297605

	measure 'Champions Awarded Aux' =
			VAR _selected = SELECTEDVALUE(DimNationsAux[nation_name])
			VAR _titles =
			    CALCULATETABLE(
			        VALUES(FactMatchTeam[year]),
			        REMOVEFILTERS(DimNations),
			        DimNations[nation_name] = _selected,
			        FactMatchTeam[round] = "Final",
			        FactMatchTeam[result] = "W"
			    )
			VAR _count = COUNTROWS(_titles)
			VAR _years =
			    CONCATENATEX(
			        TOPN(99, _titles, FactMatchTeam[year], ASC),
			        FORMAT(FactMatchTeam[year], "0"),
			        ", ",
			        FactMatchTeam[year], ASC
			    )
			RETURN
			    IF(
			        ISBLANK(_selected),
			        BLANK(),
			        IF(
			            _count = 0 || ISBLANK(_count),
			            "0",
			            FORMAT(_count, "0") & " (" & _years & ")"
			        )
			    )
		displayFolder: _information_aux
		lineageTag: 5ab96fc1-83b9-4c1e-86d4-ed31c8cc682f


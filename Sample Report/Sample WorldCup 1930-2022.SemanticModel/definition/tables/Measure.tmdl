	measure Record =
			VAR _W = COALESCE(CALCULATE(COUNTROWS(FactMatchTeam), FactMatchTeam[result] = "W"), 0)
			VAR _D = COALESCE(CALCULATE(COUNTROWS(FactMatchTeam), FactMatchTeam[result] = "D"), 0)
			VAR _L = COALESCE(CALCULATE(COUNTROWS(FactMatchTeam), FactMatchTeam[result] = "L"), 0)
			RETURN
			    IF(
			        _W = 0 && _D = 0 && _L = 0,
			        BLANK(),
			        FORMAT(_W, "0") & " - " & FORMAT(_D, "0") & " - " & FORMAT(_L, "0")
			    )
		displayFolder: _statistics
		lineageTag: bb683830-22f9-4beb-93ed-44a43e336ca8

	measure 'Record Aux' =
			VAR _selected = SELECTEDVALUE(DimNationsAux[nation_name])
			VAR _W = COALESCE(CALCULATE(COUNTROWS(FactMatchTeam), REMOVEFILTERS(DimNations), DimNations[nation_name] = _selected, FactMatchTeam[result] = "W"), 0)
			VAR _D = COALESCE(CALCULATE(COUNTROWS(FactMatchTeam), REMOVEFILTERS(DimNations), DimNations[nation_name] = _selected, FactMatchTeam[result] = "D"), 0)
			VAR _L = COALESCE(CALCULATE(COUNTROWS(FactMatchTeam), REMOVEFILTERS(DimNations), DimNations[nation_name] = _selected, FactMatchTeam[result] = "L"), 0)
			RETURN
			    IF(
			        ISBLANK(_selected),
			        BLANK(),
			        FORMAT(_W, "0") & " - " & FORMAT(_D, "0") & " - " & FORMAT(_L, "0")
			    )
		displayFolder: _statistics_aux
		lineageTag: 34d02be6-77a9-4dd9-b633-8c74f47130b8

	measure _best_result_color =
			VAR _a = [_best_round_order]
			VAR _b = [_best_round_order_aux]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_a) || ISBLANK(_b), "#F39C12",
			        _a < _b, "#2ECC71",
			        _a > _b, "#E74C3C",
			        "#F39C12"
			    )
		isHidden
		displayFolder: _temperature
		lineageTag: 71826928-7f20-44f7-9678-d6d3141cd88b

	measure _best_result_color_aux =

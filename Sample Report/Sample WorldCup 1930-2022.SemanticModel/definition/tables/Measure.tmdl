	measure 'Avr Goals Scored Aux' =
			VAR _selected = SELECTEDVALUE(DimNationsAux[nation_name])
			VAR _matches = CALCULATE(COUNTROWS(FactMatchTeam), REMOVEFILTERS(DimNations), DimNations[nation_name] = _selected)
			VAR _goals = CALCULATE(SUM(FactMatchTeam[goals_scored]), REMOVEFILTERS(DimNations), DimNations[nation_name] = _selected)
			RETURN DIVIDE(_goals, _matches)
		formatString: 0.00
		displayFolder: _statistics_aux
		lineageTag: 56a1d66d-e37e-45fe-bceb-2c35ac1e1fec

	measure 'Avr Goals Conceded Aux' =
			VAR _selected = SELECTEDVALUE(DimNationsAux[nation_name])
			VAR _matches = CALCULATE(COUNTROWS(FactMatchTeam), REMOVEFILTERS(DimNations), DimNations[nation_name] = _selected)
			VAR _goals = CALCULATE(SUM(FactMatchTeam[goals_conceded]), REMOVEFILTERS(DimNations), DimNations[nation_name] = _selected)
			RETURN DIVIDE(_goals, _matches)
		formatString: 0.00
		displayFolder: _statistics_aux
		lineageTag: bf79c53f-d348-427c-968c-7e9eff371fa2

	measure 'Avr Match Goals Aux' =
			VAR _selected = SELECTEDVALUE(DimNationsAux[nation_name])
			VAR _matches = CALCULATE(COUNTROWS(FactMatchTeam), REMOVEFILTERS(DimNations), DimNations[nation_name] = _selected)
			VAR _scored = CALCULATE(SUM(FactMatchTeam[goals_scored]), REMOVEFILTERS(DimNations), DimNations[nation_name] = _selected)
			VAR _conceded = CALCULATE(SUM(FactMatchTeam[goals_conceded]), REMOVEFILTERS(DimNations), DimNations[nation_name] = _selected)
			RETURN DIVIDE(_scored + _conceded, _matches)
		formatString: 0.00
		displayFolder: _statistics_aux
		lineageTag: aee22ad8-ffae-4815-85b5-92e32904a763

	measure 'Win Rate Aux' =
			VAR _selected = SELECTEDVALUE(DimNationsAux[nation_name])
			VAR _W = CALCULATE(COUNTROWS(FactMatchTeam), REMOVEFILTERS(DimNations), DimNations[nation_name] = _selected, FactMatchTeam[result] = "W")
			VAR _matches = CALCULATE(COUNTROWS(FactMatchTeam), REMOVEFILTERS(DimNations), DimNations[nation_name] = _selected)
			RETURN DIVIDE(_W, _matches)
		formatString: 0.0%
		displayFolder: _statistics_aux
		lineageTag: 500decf2-9166-4c06-9604-08de4be9aca8


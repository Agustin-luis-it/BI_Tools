	measure 'Avr Goals Scored' =
			VAR _matches = COUNTROWS(FactMatchTeam)
			RETURN
			    IF(
			        _matches = 0 || ISBLANK(_matches),
			        BLANK(),
			        DIVIDE(SUM(FactMatchTeam[goals_scored]), _matches)
			    )
		formatString: 0.00
		displayFolder: _statistics
		lineageTag: 0530494f-0b5a-4a20-8181-6f9aee82814b

	measure 'Avr Goals Conceded' =
			VAR _matches = COUNTROWS(FactMatchTeam)
			RETURN
			    IF(
			        _matches = 0 || ISBLANK(_matches),
			        BLANK(),
			        DIVIDE(SUM(FactMatchTeam[goals_conceded]), _matches)
			    )
		formatString: 0.00
		displayFolder: _statistics
		lineageTag: 20940d39-30d3-466f-bc6f-8b92cb8d1b95

	measure 'Avr Match Goals' =
			VAR _matches = COUNTROWS(FactMatchTeam)
			RETURN
			    IF(
			        _matches = 0 || ISBLANK(_matches),
			        BLANK(),
			        DIVIDE(
			            SUM(FactMatchTeam[goals_scored]) + SUM(FactMatchTeam[goals_conceded]),
			            _matches
			        )
			    )
		formatString: 0.00
		displayFolder: _statistics
		lineageTag: 1f0b8344-4179-48e1-a7b1-54abbff53ab8

	measure 'Win Rate' =
			VAR _W = CALCULATE(COUNTROWS(FactMatchTeam), FactMatchTeam[result] = "W")
			VAR _matches = COUNTROWS(FactMatchTeam)
			RETURN DIVIDE(_W, _matches)
		formatString: 0.0%
		displayFolder: _statistics
		lineageTag: 99770b78-452e-4635-9666-576322365512


	measure _win_rate_color =
			VAR _a = [Win Rate]
			VAR _b = [Win Rate Aux]
			VAR _selected_aux = SELECTEDVALUE(DimNationsAux[nation_name])
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_a) || ISBLANK(_selected_aux), "#F39C12",
			        _a > _b, "#2ECC71",
			        _a < _b, "#E74C3C",
			        "#F39C12"
			    )

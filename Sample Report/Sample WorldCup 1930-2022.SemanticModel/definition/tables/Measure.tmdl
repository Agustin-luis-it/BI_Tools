			RETURN
			    CALCULATE(
			        COUNTROWS(FactMatch),
			        FactMatch[score_normalized] = _selected_score
			    )
		formatString: 0
		displayFolder: _world_cup_metrics
		lineageTag: 8b17ab30-7980-47e8-9fdd-db0add3ed7fc

	measure 'Matches With Zero' =
			VAR _matches_with_zero =
			    CALCULATE(
			        COUNTROWS(FactMatch),
			        FactMatch[home_score] = 0 || FactMatch[away_score] = 0
			    )
			VAR _total = COUNTROWS(FactMatch)
			RETURN _matches_with_zero
		formatString: 0
		displayFolder: _world_cup_metrics
		lineageTag: d968e8c0-660f-40c3-bca4-2c4466a8bced

	measure 'Matches With Zero %' =
			VAR _matches_with_zero =
			    CALCULATE(
			        COUNTROWS(FactMatch),
			        FactMatch[home_score] = 0 || FactMatch[away_score] = 0
			    )
			VAR _total = COUNTROWS(FactMatch)
			RETURN DIVIDE(_matches_with_zero, _total)
		formatString: 0.0%
		displayFolder: _world_cup_metrics
		lineageTag: d5065732-11a1-43fd-add6-1a19361fa606

	measure 'Score Occurrences %' =
			VAR _count = COUNTROWS(FactMatch)
			VAR _total = CALCULATE(COUNTROWS(FactMatch), ALL(FactMatch[score_normalized]))
			RETURN DIVIDE(_count, _total)
		formatString: 0.0%
		displayFolder: _world_cup_metrics
		lineageTag: f40b9ece-d14b-4853-af33-47b45609043c

	measure 'Matches With Zero (Label)' =
			VAR _count =
			    CALCULATE(
			        COUNTROWS(FactMatch),
			        FactMatch[home_score] = 0 || FactMatch[away_score] = 0
			    )
			VAR _total = CALCULATE(COUNTROWS(FactMatch), ALL(FactMatch[score_normalized]))
			VAR _pct = DIVIDE(_count, _total)
			RETURN
			    FORMAT(_count, "0") & " (" & FORMAT(_pct, "0.0%") & ")"
		displayFolder: _world_cup_metrics
		lineageTag: 1928efde-61b4-4508-8ada-71b30702f5c8

	measure 'Matches With Draw (Label)' =
			VAR _count =
			    CALCULATE(
			        COUNTROWS(FactMatch),
			        FactMatch[home_score] = FactMatch[away_score]
			    )
			VAR _total = CALCULATE(COUNTROWS(FactMatch), ALL(FactMatch[score_normalized]))
			VAR _pct = DIVIDE(_count, _total)
			RETURN
			    FORMAT(_count, "0") & " (" & FORMAT(_pct, "0.0%") & ")"
		displayFolder: _world_cup_metrics
		lineageTag: b5779f26-005b-4ad7-a702-de358f04288a

	measure 'Avr Goals Per Match (Label)' =
			VAR _total_goals = SUM(FactMatch[home_score]) + SUM(FactMatch[away_score])
			VAR _matches = COUNTROWS(FactMatch)
			VAR _avg = DIVIDE(_total_goals, _matches)
			RETURN FORMAT(_avg, "0.00")
		displayFolder: _world_cup_metrics
		lineageTag: 7194423b-da22-4cf1-8ec5-0c2bef2700f5


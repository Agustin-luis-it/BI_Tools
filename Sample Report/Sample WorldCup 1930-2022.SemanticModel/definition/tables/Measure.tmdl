	measure _best_round_order =
			VAR _won_final =
			    CALCULATE(
			        COUNTROWS(FactMatchTeam),
			        FactMatchTeam[round] = "Final",
			        FactMatchTeam[result] = "W"
			    )
			VAR _rounds =
			    CALCULATETABLE(
			        SUMMARIZE(FactMatchTeam, FactMatchTeam[round])
			    )
			VAR _with_order =
			    ADDCOLUMNS(
			        _rounds,
			        "order",
			        SWITCH(
			            [round],
			            "Final",                IF(_won_final > 0, 0, 1),
			            "Third place",          2,
			            "Semi-finals",          3,
			            "Quarter-finals",       4,
			            "Round of 16",          5,
			            "Second round",         5,
			            "Second group stage",   5,
			            "First group stage",    6,
			            "First round",          6,
			            "Group stage",          6,
			            99
			        )
			    )
			RETURN MINX(_with_order, [order])
		isHidden
		displayFolder: _information
		lineageTag: 367eeeeb-42e8-4788-9bc3-5902f2d43830

	measure _best_round_order_aux =
			VAR _selected = SELECTEDVALUE(DimNationsAux[nation_name])
			VAR _won_final =
			    CALCULATE(
			        COUNTROWS(FactMatchTeam),
			        REMOVEFILTERS(DimNations),
			        DimNations[nation_name] = _selected,
			        FactMatchTeam[round] = "Final",
			        FactMatchTeam[result] = "W"
			    )
			VAR _rounds =
			    CALCULATETABLE(
			        SUMMARIZE(FactMatchTeam, FactMatchTeam[round]),
			        REMOVEFILTERS(DimNations),
			        DimNations[nation_name] = _selected
			    )
			VAR _with_order =
			    ADDCOLUMNS(
			        _rounds,
			        "order",
			        SWITCH(
			            [round],
			            "Final",                IF(_won_final > 0, 0, 1),
			            "Third place",          2,
			            "Semi-finals",          3,
			            "Quarter-finals",       4,
			            "Round of 16",          5,
			            "Second round",         5,
			            "Second group stage",   5,
			            "First group stage",    6,
			            "First round",          6,
			            "Group stage",          6,
			            99
